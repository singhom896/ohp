/* =========================================================
   OPPORTUNITY HUB - HERO BANNER CAROUSEL
   ========================================================= */

.hero-carousel-section {
    padding: 0 0 38px;
    background: transparent;
}


/* Main carousel container */

.hero-carousel {
    position: relative;
    width: 100%;
    aspect-ratio: 1380 / 650;

    overflow: hidden;

    border-radius: 22px;
    border: 1px solid rgba(198, 155, 67, .55);

    background: #fbf3e5;
}

.hero-slide {
    position: absolute;
    inset: 0;

    width: 100%;
    height: 100%;

    opacity: 0;
    visibility: hidden;

    transition: opacity .7s ease;
}

.hero-slide.active {
    opacity: 1;
    visibility: visible;
}

.hero-slide img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: contain;
    object-position: center;
}


/* =========================================================
   CAROUSEL ARROWS
   ========================================================= */

.carousel-control {
    position: absolute;

    top: 50%;

    transform: translateY(-50%);

    width: 46px;
    height: 46px;

    border: 1px solid rgba(255,255,255,.65);

    border-radius: 50%;

    background: rgba(91,21,48,.78);

    color: #fff;

    font-size: 23px;

    line-height: 1;

    display: flex;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    z-index: 10;

    backdrop-filter: blur(5px);

    transition:
        background .2s ease,
        transform .2s ease,
        box-shadow .2s ease;
}


.carousel-control:hover {
    background: #7c1d3e;

    box-shadow:
        0 7px 18px rgba(60,20,35,.25);

    transform: translateY(-50%) scale(1.06);
}


.carousel-prev {
    left: 18px;
}


.carousel-next {
    right: 18px;
}


/* =========================================================
   DOT INDICATORS
   ========================================================= */

.carousel-indicators {
    position: absolute;

    left: 50%;

    bottom: 17px;

    transform: translateX(-50%);

    z-index: 10;

    display: flex;

    align-items: center;

    gap: 9px;

    padding: 7px 11px;

    border-radius: 30px;

    background: rgba(40,20,30,.42);

    backdrop-filter: blur(5px);
}


.carousel-dot {
    width: 9px;
    height: 9px;

    padding: 0;

    border: 0;

    border-radius: 50%;

    background: rgba(255,255,255,.65);

    cursor: pointer;

    transition:
        width .25s ease,
        background .25s ease;
}


.carousel-dot.active {
    width: 28px;

    border-radius: 10px;

    background: #e4c276;
}


/* =========================================================
   OPTIONAL: subtle edge treatment
   ========================================================= */

.hero-carousel::after {
    content: "";

    position: absolute;

    inset: 0;

    border-radius: inherit;

    pointer-events: none;

    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.20);
}


/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 900px) {

    .hero-carousel-section {
        padding: 0 0 30px;
    }

    .hero-carousel {
        border-radius: 17px;
    }

    .carousel-control {
        width: 40px;
        height: 40px;

        font-size: 19px;
    }

    .carousel-prev {
        left: 12px;
    }

    .carousel-next {
        right: 12px;
    }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 600px) {

    .hero-carousel-section {
        padding: 0 0 25px;
    }

.hero-carousel {
    position: relative;
    width: 100%;
    aspect-ratio: 1380 / 650;

    overflow: hidden;

    border-radius: 22px;
    border: 1px solid rgba(198, 155, 67, .55);

    background: #f7ead8;

    box-shadow: 0 18px 45px rgba(70, 35, 45, .14);
}

.hero-slide img {
    width: 100%;
    height: 100%;
    display: block;

    object-fit: cover;
    object-position: center;
}

    .carousel-control {
        width: 34px;
        height: 34px;

        font-size: 16px;
    }

    .carousel-prev {
        left: 8px;
    }

    .carousel-next {
        right: 8px;
    }

    .carousel-indicators {
        bottom: 8px;

        gap: 6px;

        padding: 5px 8px;
    }

    .carousel-dot {
        width: 7px;
        height: 7px;
    }

    .carousel-dot.active {
        width: 20px;
    }

}

