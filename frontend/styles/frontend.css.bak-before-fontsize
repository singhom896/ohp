/* Banner title on the left (titles from Banner Management) */
.hero-slide.has-caption::before {
  content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
  background: linear-gradient(90deg, rgba(28,8,16,.82) 0%, rgba(28,8,16,.55) 32%, rgba(28,8,16,0) 62%);
}
.hero-caption {
  position: absolute; z-index: 2; left: clamp(70px, 7vw, 120px); top: 50%; transform: translateY(-50%);
  width: min(44%, 560px); color: #fff;
}
.hero-caption-kicker {
  display: inline-block; font-size: clamp(10px, .9vw, 13px); font-weight: 800; letter-spacing: .16em; text-transform: uppercase;
  color: #e4c276; padding-bottom: 10px; margin-bottom: 14px; border-bottom: 2px solid #e4c276;
