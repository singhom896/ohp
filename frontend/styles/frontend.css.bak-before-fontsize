/* ===== Mobile navigation (Bootstrap 5 Collapse on .main-nav#mainNav) =====
   Desktop (>=1200px, Bootstrap "xl") keeps the original inline nav.
   Below xl the nav collapses behind .nav-toggler. */
.nav-toggler{
  display:none;flex-direction:column;justify-content:center;align-items:center;gap:4px;
  width:44px;height:44px;padding:0;border:1px solid #D9D6D1;border-radius:12px;
  background:#fff;color:var(--ink);cursor:pointer;transition:.2s ease;
}
.nav-toggler:hover,.nav-toggler[aria-expanded="true"]{background:#FAF3E8;color:var(--wine)}
.nav-toggler:focus-visible{outline:2px solid var(--wine);outline-offset:2px}
.nav-toggler-bar{display:block;width:20px;height:2px;border-radius:2px;background:currentColor;transition:transform .2s ease,opacity .2s ease}
.nav-toggler[aria-expanded="true"] .nav-toggler-bar:nth-child(1){transform:translateY(6px) rotate(45deg)}
.nav-toggler[aria-expanded="true"] .nav-toggler-bar:nth-child(2){opacity:0}
.nav-toggler[aria-expanded="true"] .nav-toggler-bar:nth-child(3){transform:translateY(-6px) rotate(-45deg)}
.nav-mobile-actions{display:none}

@media (min-width:1200px){
  .main-nav.collapse{display:flex}
}
@media (max-width:1199.98px){
  .nav-row{flex-wrap:wrap;column-gap:12px;row-gap:0}
