/* Bootstrap 5 is included; custom rules below intentionally override reboot for visual parity with original prototypes. */
/* Opportunity Hub — Frontend common CSS (index + login + register)
   Preserves existing index.html design for header/footer.
   Bootstrap 5 is loaded separately; these rules keep visual parity.
*/

:root{
  --cream:#FBF3E7;
  --cream-2:#F5E9D7;
  --white:#FFFFFF;
  --ink:#0E2347;
  --ink-soft:#4A5C7B;
  --wine:#7C1D3E;
  --wine-2:#941F49;
  --gold:#CFAE63;
  --gold-soft:#DCC17E;
  --marigold:#C96F27;
  --green:#1F6F62;
  --green-2:#2E9A82;
  --purple:#5B4BB0;
  --line:#E4DED5;
  --shadow:0 16px 40px rgba(27,36,58,.08);
  --radius:24px;
  --container:1240px;
  --maroon:#8e173f;
  --maroon-dark:#3a1730;
  --navy:#121a3a;
  --border:#ddd6ce;
  --text:#111a39;
  --muted:#6c6070;
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
  color:var(--ink);
  background:var(--cream);
  line-height:1.55;
}
a{text-decoration:none;color:inherit}
button,input,select,textarea{font:inherit}
.container{width:min(var(--container),calc(100% - 48px));margin:auto}
.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:9px;
  color:var(--wine);
  text-transform:uppercase;
  letter-spacing:.18em;
  font-size:12px;
  font-weight:800;
}
.eyebrow:before{content:"";width:28px;height:1px;background:var(--gold)}
h1,h2,h3,p{margin-top:0}
h2{
  font-family:Georgia,"Times New Roman",serif;
  font-size:clamp(34px,4vw,54px);
  line-height:1.05;
  letter-spacing:-.025em;
  margin-bottom:14px;
}
h3{margin-bottom:5px}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:9px;
  min-height:46px;padding:0 19px;border-radius:999px;border:1px solid transparent;
  font-weight:750;cursor:pointer;transition:.2s ease;
}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:var(--wine);color:#fff;box-shadow:0 10px 22px rgba(124,29,62,.2)}
.btn-ghost{background:#fff;color:var(--ink);border-color:#D9D6D1}
.btn-marigold{background:var(--marigold);color:#fff}
.btn-outline-light{border-color:rgba(255,255,255,.65);color:#fff;background:transparent}

/* Government strip — index design */
.gov-strip{background:#FFF9F0;border-bottom:1px solid #E9E1D5;font-size:12px}
.gov-inner{height:46px;display:flex;justify-content:space-between;align-items:center}
.gov-identity{display:flex;gap:10px;align-items:center}
.gov-identity strong{display:block;font-size:11px}
.gov-identity small{display:block;color:#756F68;font-size:10px}
.emblem{width:40px;height:40px;border:0px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--wine);font-size:12px}
.gov-tools{display:flex;align-items:center;gap:15px;color:#5F5A55}
.gov-tools button{border:0;background:none;color:inherit;cursor:pointer}
.gov-tools .active{font-weight:800;color:var(--wine)}
.gov-tools a{color:inherit}

/* Topbar */
.topbar{background:var(--wine);color:#fff;font-size:12px}
.topbar-inner{min-height:38px;display:flex;justify-content:space-between;align-items:center}
.topbar strong{color:var(--gold-soft)}
.top-links{display:flex;gap:24px;opacity:.95}
.top-links a{color:#fff}

/* Header / nav — index design */
header.site-header, header{background:#fff;border-bottom:1px solid #EAE6E0;position:sticky;top:0;z-index:50}
.nav-row{min-height:82px;display:flex;align-items:center;gap:30px;width:min(1320px,calc(100% - 48px));margin:auto}
.brand{display:flex;align-items:center;gap:10px;min-width:270px}
.brand-mark{width:42px;height:42px;border:1px solid var(--gold);border-radius:50%;display:grid;place-items:center;color:var(--wine);font-size:19px}
.brand-copy strong{display:block;font-family:Georgia,serif;font-size:22px;line-height:1}
.brand-copy span{font-size:9px;font-weight:800;letter-spacing:.16em;color:var(--wine)}
.main-nav{display:flex;align-items:center;gap:2px;flex:1}
.nav-item{border:0;background:transparent;padding:11px 10px;border-radius:9px;color:var(--ink);font-size:13px;font-weight:700;cursor:pointer}
.nav-item:hover,.nav-item.active{background:#FAF3E8;color:var(--wine)}
.nav-actions{display:flex;gap:8px}

/* Dropdown mega */
.nav-dropdown{position:relative}
.mega{
  display:none;position:absolute;top:49px;left:0;width:690px;background:#fff;
  border:1px solid #E8E2D9;border-radius:18px;box-shadow:var(--shadow);padding:22px;
  grid-template-columns:1.05fr 1fr 1fr;gap:24px;
}
.nav-dropdown.open .mega{display:grid}
.mega h4{font-family:Georgia,serif;font-size:22px;margin:7px 0}
.mega p{font-size:12px;color:var(--ink-soft)}
.mega-kicker,.mega-heading{font-size:10px;font-weight:850;letter-spacing:.16em;color:var(--wine)}
.mega a{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid #F0ECE6}
.mega a:last-child{border-bottom:0}
.mega b{display:block;font-size:12px}
.mega small{display:block;color:#7A8190;font-size:10px;margin-top:2px}
.mega-icon{color:var(--gold);font-size:17px;width:22px}
.mega-primary{display:inline-flex!important;border:0!important;color:var(--wine);font-weight:800}

/* Hero */
.hero{position:relative;overflow:hidden;padding:78px 0 88px;background:linear-gradient(180deg,#FFF8ED 0%,var(--cream) 100%)}
.hero:after{
  content:"";position:absolute;right:-150px;top:-170px;width:510px;height:510px;border:1px solid rgba(207,174,99,.28);
  border-radius:50%;box-shadow:0 0 0 40px rgba(207,174,99,.06),0 0 0 80px rgba(207,174,99,.04);
}
.hero-grid{display:grid;grid-template-columns:1.02fr .98fr;gap:70px;align-items:center;position:relative;z-index:1}
.hero h1{font-family:Georgia,serif;font-size:clamp(50px,6vw,78px);line-height:.98;letter-spacing:-.04em;margin:15px 0 22px}
.hero h1 span{display:block;color:var(--wine)}
.lede{max-width:680px;color:var(--ink-soft);font-size:16px}
.hero-actions{display:flex;gap:10px;margin:28px 0}
.search-card{
  display:grid;grid-template-columns:1.4fr 1fr 1fr auto;gap:0;background:#fff;border:1px solid #E4DED4;
  border-radius:18px;box-shadow:var(--shadow);overflow:hidden;max-width:780px
}
.search-card label{display:flex;align-items:center;gap:9px;padding:0 14px;border-right:1px solid #EAE4DA;color:#8A8E95}
.search-card input{border:0;outline:0;width:100%;padding:16px 0;background:transparent;font-size:12px;color:var(--ink)}
.search-card button{border:0;background:var(--wine);color:#fff;padding:0 22px;font-weight:800;cursor:pointer}
.hero-art{position:relative}
.art-frame{
  min-height:430px;border-radius:30px;border:1px solid #DED5C9;background:#F1E2D1;
  position:relative;overflow:hidden;box-shadow:var(--shadow);
  display:grid;place-items:center;
}
.art-frame:before,.art-frame:after{content:"";position:absolute;border-radius:50%;border:1px solid rgba(124,29,62,.25)}
.art-frame:before{width:330px;height:330px}
.art-frame:after{width:430px;height:430px}
.stage{
  width:70%;height:74%;position:relative;z-index:2;
  background:linear-gradient(145deg,#7C1D3E,#C96F27);border-radius:48% 48% 12% 12%;
  box-shadow:0 25px 50px rgba(80,28,30,.22)
}
.stage:before{content:"";position:absolute;left:15%;right:15%;bottom:14%;height:48%;border-radius:50% 50% 12px 12px;background:rgba(255,245,225,.78)}
.stage:after{content:"♪   ✦   ♫";position:absolute;top:15%;left:16%;font-size:28px;color:#fff;letter-spacing:18px}
.hero-badge{position:absolute;right:-14px;bottom:25px;background:#fff;padding:16px 19px;border-radius:16px;box-shadow:var(--shadow);width:180px}
.hero-badge strong{font-size:25px;color:var(--wine);display:block}
.hero-badge span{font-size:11px;color:var(--ink-soft)}

/* Categories / stats */
.categories{padding:52px 0;background:#fff}
.cat-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:12px}
.cat-card{border:1px solid #E7E1D8;border-radius:16px;padding:18px 12px;background:#FFFCF7;text-align:center;transition:.2s}
.cat-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.cat-icon{width:42px;height:42px;border-radius:13px;display:grid;place-items:center;margin:0 auto 10px;font-size:19px}
.cat-card h3{font-size:16px;margin-bottom:3px}
.cat-card p{font-size:12px;color:#7B8190;margin:0}
.stats{background:var(--ink);color:#fff;padding:32px 0}
.stats-grid{display:grid;grid-template-columns:repeat(4,1fr)}
.stat{text-align:center;border-right:1px solid rgba(255,255,255,.14);padding:5px 20px}
.stat:last-child{border-right:0}
.stat strong{display:block;font-family:Georgia,serif;font-size:31px;color:var(--gold-soft)}
.stat span{font-size:11px;color:#CBD2DF}

/* Sections */
.section{padding:82px 0}
.section-head{text-align:center;margin-bottom:38px}
.section-head p{color:var(--ink-soft);max-width:650px;margin:0 auto;font-size:14px}

/* Opportunities */
.opportunity-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.opp-card{background:#fff;border:1px solid #E5DED5;border-radius:20px;overflow:hidden;box-shadow:0 8px 22px rgba(20,30,50,.05)}
.opp-thumb {
    width: 100%;
    height: 165px;
    object-fit: cover;
    display: block;
    border-top-left-radius: 8px; /* Optional: matches card corner radius if needed */
    border-top-right-radius: 8px;
}
.opp-body{padding:20px}
.tag{display:inline-block;border-radius:999px;padding:5px 9px;font-size:9px;font-weight:850;text-transform:uppercase;letter-spacing:.08em;background:#FCEBD8;color:var(--marigold)}
.opp-body h3{font-family:Georgia,serif;font-size:22px;margin-top:11px}
.opp-body p{font-size:12px;color:var(--ink-soft)}
.meta{display:flex;gap:18px;font-size:10px;color:#777E8D;padding-top:12px;border-top:1px solid #EEE8E0}

/* How it works */
.how{background:#fff}
.how-grid{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center}
.steps{display:grid;gap:15px}
.step{display:flex;gap:16px;align-items:flex-start;padding:16px;border:1px solid #E8E1D7;border-radius:17px;background:#FFFDF9}
.step-num{width:35px;height:35px;border-radius:50%;background:#F4E5D0;color:var(--wine);display:grid;place-items:center;font-weight:900}
.step h3{font-size:15px}.step p{font-size:12px;color:var(--ink-soft);margin:0}
.process-art{min-height:370px;border-radius:28px;background:#F7EBDD;border:1px solid #E7D9C8;position:relative;overflow:hidden;padding:34px}
.process-art .circle{width:245px;height:245px;border-radius:50%;border:1px solid var(--gold);margin:25px auto;display:grid;place-items:center;font-family:Georgia,serif;font-size:28px;color:var(--wine);text-align:center}
.process-art .node{position:absolute;background:#fff;border:1px solid #E4DDD2;border-radius:12px;padding:9px 12px;font-size:10px;font-weight:800;box-shadow:0 8px 20px rgba(30,30,30,.06)}
.n1{top:22px;left:25px}.n2{top:60px;right:22px}.n3{bottom:25px;left:38px}.n4{bottom:35px;right:34px}

/* Gallery */
.gallery{background:#F4E8D8}
.gallery-grid{display:grid;grid-template-columns:2fr 1fr 1fr;grid-auto-rows:190px;gap:14px}
.gallery-card{border-radius:18px;overflow:hidden;position:relative;padding:18px;display:flex;align-items:flex-end;color:#fff;background:linear-gradient(135deg,#7C1D3E,#C96F27)}
.gallery-card.tall{grid-row:span 2}
.gallery-card.green{background:linear-gradient(135deg,#1F6F62,#2E9A82)}
.gallery-card.purple{background:linear-gradient(135deg,#5B4BB0,#8B6FE0)}
.gallery-card.orange{background:linear-gradient(135deg,#B4682B,#E8A458)}
.gallery-card span{position:relative;z-index:2;font-weight:800;font-size:13px;text-shadow:0 1px 3px rgba(0,0,0,.2)}
.gallery-card small{display:block;font-weight:500;opacity:.86}
.play{position:absolute;right:15px;top:15px;width:38px;height:38px;border-radius:50%;background:rgba(255,255,255,.22);display:grid;place-items:center}

/* Testimonials */
.testimonials{padding:82px 0;background:var(--cream)}
.testimonial-section + .testimonial-section{border-top:1px solid rgba(207,174,99,.34);background:#FFF9F1}
.testimonial-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.testimonial-card{
  min-height:355px;background:#fff;border:1px solid #E0DAD2;border-radius:24px;padding:34px 36px;
  display:flex;flex-direction:column;box-shadow:0 12px 28px rgba(26,31,42,.045)
}
.quote{font-family:Georgia,serif;font-size:64px;line-height:.7;color:var(--gold-soft);height:48px}
.testimonial-text{font-size:16px;line-height:1.7;color:#445A7C;margin:25px 0 auto}
.person{display:flex;align-items:center;gap:14px;padding-top:22px;border-top:1px solid #E9E4DE}
.avatar{width:60px;height:60px;border-radius:50%;display:grid;place-items:center;color:#fff;font-size:11px;font-weight:900}
.person strong{display:block;font-size:16px}.person span{display:block;color:#52617A;font-size:11px;margin-top:3px}
.section-label-center{text-align:center}

/* CTA */
.cta{background:var(--wine);color:#fff;padding:55px 0;position:relative;overflow:hidden}
.cta:after{content:"✦  ◇  ✦  ◇  ✦";position:absolute;right:4%;top:15px;color:rgba(255,255,255,.1);font-size:70px}
.cta-grid{display:grid;grid-template-columns:1fr 1px 1fr;gap:35px;align-items:center}
.cta-side{display:grid;grid-template-columns:auto 1fr auto;gap:15px;align-items:center}
.cta-side h3{font-family:Georgia,serif;font-size:24px;margin:0 0 4px}.cta-side p{margin:0;color:#F0DDE3;font-size:12px}
.cta-icon{width:45px;height:45px;border:1px solid rgba(255,255,255,.4);border-radius:14px;display:grid;place-items:center}
.cta-divider{height:78px;background:rgba(255,255,255,.22)}

/* Footer: see 'Footer (design)' at the end of this file */

.prototype-bar{position:fixed;right:18px;bottom:18px;z-index:100;display:flex;gap:7px;padding:8px;background:#fff;border:1px solid #E1DCD5;border-radius:14px;box-shadow:var(--shadow)}
.prototype-bar button{border:0;background:#F7F1E9;color:var(--ink);padding:8px 11px;border-radius:8px;font-size:11px;font-weight:800;cursor:pointer}
.prototype-bar button:hover{background:#EEE2D1}

/* ===== Auth pages (login / register) form area — keep existing look ===== */
.page{min-height:735px;padding:54px 0 65px}
.auth-shell{
  width:min(1260px, calc(100% - 60px));
  min-height:680px;
  margin:0 auto;
  display:grid;
  grid-template-columns:45% 55%;
  background:#fff;
  border-radius:28px;
  overflow:hidden;
  box-shadow:0 18px 45px rgba(36,24,30,.08);
}
.auth-art{
  padding:58px 54px;
  color:#fff;
  background:linear-gradient(155deg,#8e173f 0%,#4b1935 52%,#24182e 100%);
}
.auth-art .eyebrow{margin-bottom:22px;color:#f1c65b;font-size:13px;font-weight:800;letter-spacing:2.2px}
.auth-art h2{
  margin:0 0 24px;max-width:550px;
  font-family:Georgia, "Times New Roman", serif;
  font-size:49px;line-height:1.14;font-weight:700;
}
.auth-art p{max-width:540px;margin:0 0 24px;font-size:17px;line-height:1.55}
.feature-list{list-style:none;padding:0;margin:0}
.feature-list li{margin:20px 0;font-size:17px}
.auth-form{padding:54px 50px 40px;background:#fff}
.auth-form h2{
  margin:0 0 25px;
  font-family:Georgia, "Times New Roman", serif;
  font-size:40px;color:#101735;
}
.muted{color:#76677a;font-size:16px}
.role-tabs{display:flex;gap:9px;margin:28px 0 25px}
.role-tab{
  border:1px solid #ded9df;background:#fff;border-radius:11px;
  padding:14px 19px;font-size:16px;font-weight:700;color:#111;
}
.role-tab.active{background:var(--maroon);color:#fff;border-color:var(--maroon)}
.field{margin-bottom:19px}
.field label{display:block;margin-bottom:9px;color:#111735;font-size:14px;font-weight:700}
.field input[type="text"],
.field input[type="password"],
.field input[type="email"]{
  width:100%;height:54px;padding:0 14px;
  border:1px solid #d8d3db;border-radius:10px;
  font:16px Arial, Helvetica, sans-serif;color:#111735;outline:none;
}
.field input:focus{border-color:var(--maroon);box-shadow:0 0 0 3px rgba(142,23,63,.08)}
.check{display:flex!important;align-items:center;gap:10px;font-size:14px!important}
.check input{width:16px;height:16px}
.submit{
  width:100%;height:56px;border-radius:11px;font-size:16px;font-weight:700;cursor:pointer;
  border:1px solid var(--maroon);background:var(--maroon);color:#fff;
}
/* CAPTCHA (components/auth/Captcha.tsx): answer box + image + refresh on one line */
.captcha-row{display:flex;align-items:center;gap:10px}
.field .captcha-row .captcha-input{flex:1 1 auto;min-width:0;width:auto;height:52px}
.captcha-img{
  flex:0 0 188px;width:188px;height:52px;display:grid;place-items:center;overflow:hidden;
  border:2px solid #cfc6bb;border-radius:10px;background:#fdf8f1;
}
.captcha-img img{display:block;width:100%;height:100%;object-fit:contain}
.captcha-refresh{
  flex:0 0 52px;width:52px;height:52px;border:1px solid #d8d3db;border-radius:10px;background:#fff;
  color:var(--maroon);font-size:24px;line-height:1;cursor:pointer;
}
.captcha-refresh:hover:not(:disabled){border-color:var(--maroon);background:#fbf3f5}
.captcha-refresh:disabled{opacity:.5;cursor:wait}
@media(max-width:420px){
  .captcha-img{flex-basis:140px;width:140px;height:46px}
  .captcha-refresh{flex-basis:46px;width:46px;height:46px}
  .field .captcha-row .captcha-input{height:46px}
}.field input[aria-invalid="true"],
.form-grid .field input[aria-invalid="true"]{border-color:#dc3545}
.auth-links{text-align:center;margin-top:18px;font-size:14px;line-height:1.8}
.auth-links a{color:var(--maroon);font-weight:700}

/* Register card */
.register-card{
  width:min(900px,100%);
  background:#fff;
  border:1px solid #ddd8d0;
  border-radius:17px;
  overflow:hidden;
  box-shadow:0 18px 45px rgba(31,45,65,.10);
  margin:0 auto;
}
.register-card .intro{
  padding:32px 34px 30px;
  background:linear-gradient(115deg,#fffaf0 0%,#f8edf0 100%);
  border-bottom:1px solid #e2ddd5;
}
.kicker{color:#8d1d45;font-size:10px;font-weight:800;letter-spacing:2px;margin-bottom:12px}
.register-card h1{
  font-family:Georgia,"Times New Roman",serif;
  color:#102b55;font-size:34px;line-height:1.15;margin:0 0 10px;
}
.subtitle{color:#315887;font-size:13px;line-height:1.55;max-width:720px;margin-bottom:22px}
.type-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.type-card{
  min-height:134px;background:#fff;border:1px solid #dcdde1;border-radius:12px;
  padding:15px;cursor:pointer;transition:.15s ease;
}
.type-card:hover{border-color:#9a3658}
.type-card.selected{border:2px solid #9a1745;background:#fff8f8;padding:14px}
.type-title{color:#102b55;font-weight:800;font-size:15px;line-height:1.25;display:flex;gap:8px;align-items:flex-start}
.type-icon{font-size:16px}
.type-desc{color:#315887;font-size:11px;line-height:1.45;margin-top:8px}
.form-area{padding:28px 34px 25px}
.notice{
  background:#fff7e8;border-left:4px solid #e78b2c;border-radius:7px;
  padding:13px;color:#665944;font-size:11px;line-height:1.45;margin-bottom:23px;
}
.notice strong{color:#1e3655}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px 14px}
.form-grid .field label{font-size:11px;color:#102b55;font-weight:800;margin-bottom:7px}
.req{color:#8d1d45}
.form-grid .field input{
  width:100%;height:40px;border:1px solid #d6d3db;border-radius:9px;
  padding:0 12px;color:#102b55;font-size:13px;outline:none;background:#fff;
}
.form-grid .field input:focus{border-color:#8d1d45;box-shadow:0 0 0 2px rgba(141,29,69,.08)}
.form-grid .field select{
  width:100%;height:40px;border:1px solid #d6d3db;border-radius:9px;
  padding:0 10px;color:#102b55;font-size:13px;outline:none;background:#fff;
}
.form-grid .field select:focus{border-color:#8d1d45;box-shadow:0 0 0 2px rgba(141,29,69,.08)}
.form-grid .field select[aria-invalid="true"]{border-color:#dc3545}
.form-grid .full-row{grid-column:1/-1}
/* Email + OTP (components/auth/EmailOtpField.tsx) */
.otp-row{display:flex;gap:8px;align-items:stretch}
.otp-row input{flex:1;min-width:0}
.otp-btn{
  flex:0 0 auto;border:1px solid #8d1d45;background:#8d1d45;color:#fff;border-radius:9px;
