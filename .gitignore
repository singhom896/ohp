# Opportunity Hub - monorepo (backend: Laravel API, frontend: Next.js)

# Secrets: never commit (copy backend/.env.example to backend/.env)
.env
.env.*
!.env.example

# Dependencies and build output
node_modules/
/backend/vendor/
.next/
out/

# Database dumps / backups (contain user data and password hashes)
backend/storage/app/backups/
*.sql
*.sqlite

# Logs, caches, editor and OS files
*.log
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
